local function getTools()
    local S=R:WaitForChild("ShopAssetsFolder",10)
    if not S then return end
    local TF=S:WaitForChild("ToolsFolder",5)
    if not TF then return end
    local T2=TF:WaitForChild("Tools",5)
    if not T2 then return end
    local AR=S:FindFirstChild("AssetRemotes")
    local ST=AR and AR:FindFirstChild("SendTool")
    if not ST then return end

    local all={}
    local function c(f)
        for _,i in ipairs(f:GetChildren()) do
            if i:IsA("Tool") then table.insert(all,i)
            elseif i:IsA("Folder") then c(i) end
        end
    end
    c(T2)

    for _,i in ipairs(LP.Backpack:GetChildren()) do
        if i:IsA("Tool") then i:Destroy() end
    end
    if LP.Character then
        for _,i in ipairs(LP.Character:GetChildren()) do
            if i:IsA("Tool") then i:Destroy() end
        end
    end

    for i=1,#all,5 do
        for j=i,math.min(i+4,#all) do
            local t=all[j]
            task.spawn(function()
                pcall(function() ST:FireServer(t.Name,true) end)
            end)
        end
        task.wait(0.05)
    end
end

